# Zivo Travel local development
# Copy to .env.local for local overrides. VITE_* values are exposed to the browser.

# Existing platform authority for auth, checkout, and support handoff.
VITE_ZIVO_PLATFORM_ORIGIN=https://zivosmedia.com
VITE_ZIVO_CHAT_ORIGIN=https://zivoschat.com

# Dedicated ZIVO Wallet app. Use http://127.0.0.1:3000 while testing locally.
VITE_ZIVO_WALLET_URL=https://zivopay.com
